    <string name="permission_notifications">Notifications</string>
    <string name="permission_notifications_help">Needed to show warnings with their Done and I failed buttons.</string>
    <string name="permission_popup">Pop-up and sound</string>
    <string name="permission_popup_help">Warnings are set to a quiet level. Allow pop-ups for the Warnings channel so they are hard to miss.</string>

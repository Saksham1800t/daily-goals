    <string name="poc_title">Blocking test</string>
    <string name="poc_intro">A proof of concept with one test app and no goals. It finds out which way of showing a block works on this phone. Nothing here is saved to your goals.</string>
    <string name="poc_step_restricted">1. Allow restricted settings</string>
    <string name="poc_restricted_help">Android may grey out the switch for an app you installed from a file. If so, open the app info, tap the three dots at the top right and choose \"Allow restricted settings\". If you do not see that menu item, go on to step 2.</string>
    <string name="poc_open_app_info">Open app info</string>
    <string name="poc_step_service">2. Turn on the blocker</string>
    <string name="poc_service_help">Open Accessibility settings, find Skriti under downloaded or installed apps, and switch it on. Android asks you to confirm.</string>
    <string name="poc_status_enabled">Switched on in settings</string>
    <string name="poc_status_running">Running now</string>
    <string name="poc_open_accessibility">Open Accessibility settings</string>
    <string name="poc_status_overlay">Display over other apps</string>
    <string name="poc_status_battery">Battery: unrestricted</string>
    <string name="poc_allow_overlay">Allow display over apps</string>
    <string name="poc_allow_battery">Allow in background</string>
    <string name="poc_extra_permissions_help">Display over other apps lets the service open a block screen. The battery setting asks Android not to stop the blocker while the phone sits idle.</string>
    <string name="poc_keep_alive">Keep the blocker alive</string>
    <string name="poc_keep_alive_help">Shows a quiet notification while the service runs, so Android is less likely to stop it.</string>
    <string name="poc_method_home_activity">Home, then block screen</string>
    <string name="poc_method_home_activity_help">Presses Home and then opens a block screen of this app. Needs Display over other apps.</string>
    <string name="poc_privacy_note">Android may later show a notice that this service can see which app is open. That is expected: it reads package names only, never the screen.</string>
    <string name="poc_step_test">3. Run a test</string>
    <string name="poc_target">Package name of the test app</string>
    <string name="poc_method">How to block</string>
    <string name="poc_method_activity">Open a block screen</string>
    <string name="poc_method_activity_help">The service starts a screen of this app over the test app.</string>
    <string name="poc_method_overlay">Draw a block view</string>
    <string name="poc_method_overlay_help">The service draws the block in an accessibility overlay window. No extra permission.</string>
    <string name="poc_method_home">Send home</string>
    <string name="poc_method_home_help">The service presses Home every time the test app opens. Apps like YouTube then shrink to a floating window and keep playing.</string>
    <string name="poc_method_overlay_home">Block view, then send home</string>
    <string name="poc_method_overlay_home_help">The overlay shows, and after 2.5 seconds Home is pressed.</string>
    <string name="poc_method_activity_home">Block screen, home if it fails</string>
    <string name="poc_method_activity_home_help">Tries the block screen and presses Home when it did not open.</string>
    <string name="poc_pause_media">Pause the app\'s sound</string>
    <string name="poc_pause_media_help">A block does not stop a video or music playing behind it. This presses pause on whatever is playing when the block appears.</string>
    <string name="poc_service_off_warning">The test is on, but the blocker is switched off in Accessibility settings, so nothing is blocked. Android switches it off when the app is force-stopped. Switch it on again.</string>

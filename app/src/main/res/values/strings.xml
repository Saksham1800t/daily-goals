    <string name="permission_exact_help">Lets warnings arrive at the exact minute. Without it they can be a few minutes late.</string>
    <string name="permission_full_screen">Alerts over the lock screen</string>
    <string name="permission_full_screen_help">Only for goals with the strong alert switch on. Android may keep this off.</string>
    <string name="permission_battery">Keep this app alive</string>
    <string name="permission_battery_help">Some phones stop apps in the background. Exempting this app from battery optimisation helps warnings arrive. Some brands also have an autostart list to check.</string>
